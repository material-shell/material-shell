{
    "version": "1.1.0",
    "compileOnSave": true,
    "compilerOptions": {
        "module": "esnext",
        "target": "es2018",
        "outDir": "./build",
        "forceConsistentCasingInFileNames": true,
        "downlevelIteration": true,
        "lib": ["es2018", "dom"],
        "pretty": true,
        "sourceMap": false,
        "declaration": false,
        "removeComments": true,
        "incremental": true,
        "noImplicitAny": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "strictNullChecks": true,
        "noFallthroughCasesInSwitch": true,
        "allowJs": true,
        "strict": true,
        // `bundler` is what lets TypeScript read the "exports" map of the
        // @girs packages, which is how their ambient subpaths are published.
        "moduleResolution": "bundler",
        "importHelpers": true,
        "baseUrl": ".",
        "experimentalDecorators": true,
        // The gi:// and resource:/// module ids are declared as ambient modules
        // by @girs/gnome-shell and its @girs/* dependencies, so no path mapping
        // is needed for them any more.
        "skipLibCheck": false
    },
    "include": [
        "src/**/*.ts",
        "@types/ambient.d.ts",
        "@types/mod.d.ts"
    ]
}
