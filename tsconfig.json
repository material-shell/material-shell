{
    "version": "1.1.0",
    "compileOnSave": true,
    "compilerOptions": {
        "module": "esnext",
        "target": "es2018",
        "outDir": "./build",
        "forceConsistentCasingInFileNames": true,
        "downlevelIteration": true,
        "lib": ["es2018", "dom"],
        "pretty": true,
        "sourceMap": false,
        "declaration": false,
        "removeComments": true,
        "incremental": true,
        "noImplicitAny": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "strictNullChecks": true,
        "noFallthroughCasesInSwitch": true,
        "allowJs": true,
        "strict": true,
        // `bundler` is what lets TypeScript read the "exports" map of the
        // @girs packages, which is how their ambient subpaths are published.
        "moduleResolution": "bundler",
        "importHelpers": true,
        "baseUrl": ".",
        "experimentalDecorators": true,
        // The gi:// and resource:/// module ids are declared as ambient modules
        // by @girs/gnome-shell and its @girs/* dependencies, so no path mapping
        // is needed for them any more.
        // This is a GJS project: do not auto-include node_modules/@types/*,
        // whose @types/node would shadow the shell's `global` object.
        "types": [],
        // @girs/gnome-shell 50.0.4 ships a background.d.ts whose
        // Animation.load_async does not match its base class, and there is
        // nothing to fix on our side; errors in our own declarations still
        // surface where src uses them.
        "skipLibCheck": true
    },
    "include": [
        "src/**/*.ts",
        "@types/ambient.d.ts",
        "@types/mod.d.ts",
        "@types/shell-internals.d.ts",
        "@types/shell-modules.d.ts"
    ]
}
